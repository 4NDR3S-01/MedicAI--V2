{
  "expo": {
    "name": "MedicAI",
    "slug": "MedicAI",
    "scheme": "medicai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.critical-alerts": true,
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "bundleIdentifier": "com.william20.medicai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.william20.medicai",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "allowBackup": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5",
          "defaultChannel": "medicai_medication_alarms"
        }
      ],
      "./plugins/withAlarmModule",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MedicAI usa la cámara solo para que fotografíes una receta o la caja de un medicamento y se la muestres al asistente.",
          "photosPermission": "MedicAI accede a la foto que elijas para mostrársela al asistente.",
          "microphonePermission": "MedicAI usa el micrófono solo mientras hablas con el asistente."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MedicAI usa el micrófono solo mientras hablas con el asistente.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "45297cfb-7617-41be-babc-6b9dddf901f3"
      }
    }
  }
}
