generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  fullName                 String?
  birthDate                String?
  phone                    String?
  passwordHash             String
  isEmailVerified          Boolean   @default(false)
  refreshTokenHash         String?
  avatar                   String?
  conditions               String?
  allergies                String?
  pregnancy                Boolean   @default(false)
  lactation                Boolean   @default(false)
  recentSurgeries          Boolean   @default(false)
  immunosuppression        Boolean   @default(false)
  anticoagulantTreatment   Boolean   @default(false)
  notificationLeadMinutes  Int       @default(5)
  // Consentimiento explícito (opt-in) para enviar el perfil de salud como
  // contexto al asistente de IA (proveedor externo). Por defecto desactivado.
  aiHealthContextConsent   Boolean   @default(false)
  aiHealthContextConsentAt DateTime?
  // Perfil a cargo (p. ej. un hijo pequeño): sin acceso propio, lo gestionan
  // sus tutores desde el Círculo. Deja de serlo al "entregar la cuenta"
  // (la persona crea su contraseña con el enlace que recibe por correo).
  isManaged                Boolean   @default(false)
  // Zona horaria IANA (p. ej. "America/Bogota") de su teléfono: las horas de
  // sus tomas ("08:00") se interpretan en ella, la mire quien la mire.
  timezone                 String?
  managedById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions            UserSession[]
  pushTokens          PushToken[]
  medications         Medication[]
  appointments        Appointment[]

  circleLinksAsA           CircleLink[]       @relation("CircleLinkUserA")
  circleLinksAsB           CircleLink[]       @relation("CircleLinkUserB")
  circleGrantsGiven        CircleGrant[]      @relation("CircleGrantOwner")
  circleGrantsReceived     CircleGrant[]      @relation("CircleGrantGrantee")
  circleInvitationsSent    CircleInvitation[] @relation("CircleInvitationInviter")
  circleInvitationsCreated CircleInvitation[] @relation("CircleInvitationCreatedBy")
  circleGroups             CircleGroup[]
  medicationsCreated       Medication[]       @relation("MedicationCreatedBy")
  medicationsUpdated       Medication[]       @relation("MedicationUpdatedBy")
  medicationLogsRecorded   MedicationLog[]    @relation("MedicationLogLoggedBy")
  appointmentsCreated      Appointment[]      @relation("AppointmentCreatedBy")
  appointmentsUpdated      Appointment[]      @relation("AppointmentUpdatedBy")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Medication {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  dosage              String
  frequency           String
  firstDoseTime       String? // Preserves the user-selected initial dose time (HH:mm)
  times               String[] // Array of "HH:mm" strings
  notes               String?
  customIntervalHours Int? // For custom frequency (e.g., 6 for every 6 hours)
  customEndDate       DateTime? // Date when custom alarms should stop
  active              Boolean   @default(true)
  // Momento de la última activación (o de la creación). Las tomas anteriores
  // a esta fecha no cuentan como pendientes ni como olvidadas.
  activeSince         DateTime? @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Quién lo agregó / cambió por última vez (puede ser alguien del Círculo).
  createdById String?
  updatedById String?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("MedicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("MedicationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  logs      MedicationLog[]

  @@index([userId])
  @@index([createdAt])
}

model MedicationLog {
  id           String     @id @default(cuid())
  medicationId String
  action       String // "TAKEN", "SKIPPED", "SNOOZED"
  takenAt      DateTime   @default(now())
  scheduledFor DateTime? // The originally scheduled time for this dose
  // Quién registró la toma (la persona o alguien que la cuida).
  loggedById   String?
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  loggedBy     User?      @relation("MedicationLogLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)

  // Compuestos: cubren "logs de estos medicamentos desde X" (GET /medications/logs)
  // y, por prefijo, las búsquedas solo por medicationId.
  @@index([medicationId, takenAt])
  @@index([medicationId, scheduledFor])
}

model Appointment {
  id                 String    @id @default(cuid())
  userId             String
  title              String
  doctorName         String
  scheduledAt        DateTime
  location           String?
  notes              String?
  active             Boolean   @default(true)
  attendanceStatus   String    @default("PENDING") // "PENDING", "ATTENDED", "MISSED"
  attendanceMarkedAt DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduledAt])
  @@index([attendanceStatus])
  @@index([createdAt])
  @@index([userId, active, scheduledAt])
}

// ─── Círculo ──────────────────────────────────────────────────────────────────
//
// CircleLink: vínculo entre dos personas (una fila por par). Guarda qué es cada
// una para la otra y quién cuida a quién. Pertenecer al Círculo NO da acceso a
// nada: el acceso lo definen los CircleGrant.
//
// CircleGrant: permisos en UNA dirección, concedidos por el dueño de la
// información (ownerId) a otra persona (granteeId). Se borran al revocar.
//
// CircleInvitation: propuesta de vínculo. Puede ir a un correo (solo esa
// cuenta puede aceptarla, aunque se registre después) o compartirse por
// código/enlace (la primera cuenta que la abre queda asociada).

model CircleLink {
  id             String    @id @default(cuid())
  userAId        String // quien invitó
  userBId        String // quien aceptó
  relationA      String // lo que A es para B (código de relación)
  relationALabel String? // texto libre cuando relationA = OTHER
  relationB      String // lo que B es para A
  relationBLabel String?
  aCaresForB     Boolean   @default(false)
  bCaresForA     Boolean   @default(false)
  status         String    @default("ACTIVE") // ACTIVE | REVOKED
  revokedAt      DateTime?
  revokedById    String?
  invitationId   String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userA  User                @relation("CircleLinkUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB  User                @relation("CircleLinkUserB", fields: [userBId], references: [id], onDelete: Cascade)
  grants CircleGrant[]
  groups CircleGroupMember[]

  @@index([userAId, status])
  @@index([userBId, status])
}

model CircleGrant {
  id                 String   @id @default(cuid())
  linkId             String
  ownerId            String // dueño de la información
  granteeId          String // quien puede actuar sobre ella
  viewMedications    Boolean  @default(false)
  addMedications     Boolean  @default(false)
  editMedications    Boolean  @default(false)
  deleteMedications  Boolean  @default(false)
  manageReminders    Boolean  @default(false)
  logDoses           Boolean  @default(false)
  viewAppointments   Boolean  @default(false)
  manageAppointments Boolean  @default(false)
  viewHealth         Boolean  @default(false)
  manageCircle       Boolean  @default(false)
  // Preferencia de QUIEN RECIBE el permiso: recibir en su teléfono los
  // recordatorios de tomas y citas del dueño. OFF | NOTIFY | ALARM.
  reminderMode       String   @default("OFF")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  link    CircleLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  owner   User       @relation("CircleGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee User       @relation("CircleGrantGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@unique([linkId, ownerId])
  @@index([granteeId, ownerId])
}

model CircleInvitation {
  id                     String    @id @default(cuid())
  inviterId              String // dueño del Círculo al que se invita
  createdById            String // quien la creó (el inviter o alguien que administra su Círculo)
  inviteeEmail           String?
  inviteeUserId          String?
  inviteeName            String? // cómo llama quien invita a esta persona
  code                   String    @unique
  inviterRelation        String // lo que el inviter es para el invitado
  inviterRelationLabel   String?
  inviterCaresForInvitee Boolean   @default(false)
  inviteeCaresForInviter Boolean   @default(false)
  grantedPermissions     Json // lo que el invitado podrá hacer con la información del inviter
  requestedPermissions   Json // lo que el inviter pide sobre la información del invitado
  // Recordatorios de la persona invitada que quien invita quiere recibir en su
  // teléfono (OFF | NOTIFY | ALARM); se aplica al aceptar.
  inviterReminderMode    String    @default("OFF")
  // Grupos (de quien invita) a los que se añadirá la persona al aceptar.
  inviterGroupIds        String[]  @default([])
  status                 String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELED
  respondedAt            DateTime?
  expiresAt              DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  inviter   User @relation("CircleInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  createdBy User @relation("CircleInvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([inviterId, status])
  @@index([inviteeEmail, status])
  @@index([inviteeUserId, status])
}

// Grupos PRIVADOS para organizar la vista del Círculo ("Familia", "Pacientes").
// No dan permisos: solo ordenan y filtran. Un vínculo puede estar en varios.
model CircleGroup {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  icon      String   @default("account-group")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members CircleGroupMember[]

  @@index([ownerId])
}

model CircleGroupMember {
  groupId String
  linkId  String

  group CircleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  link  CircleLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([groupId, linkId])
  @@index([linkId])
}

// Una sesión por dispositivo: iniciar sesión en la tablet no cierra la del
// teléfono. El refresh token lleva el id de la sesión (sid) y aquí se guarda
// solo su hash (SHA-256); al renovarlo se rota.
model UserSession {
  id               String   @id
  userId           String
  refreshTokenHash String   @unique
  deviceName       String?
  platform         String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Dispositivo que recibe notificaciones push (token de Expo). Ligado a la
// sesión: al cerrar sesión en ese dispositivo deja de recibir avisos.
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String?
  sessionId  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

// Aviso "no registró su toma" ya enviado para una toma concreta (no se repite).
model MissedDoseAlert {
  medicationId String
  scheduledFor DateTime
  sentAt       DateTime @default(now())

  @@id([medicationId, scheduledFor])
  @@index([sentAt])
}
