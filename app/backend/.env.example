PORT=4000
NODE_ENV=development
SERVICE_NAME="medicai-backend"
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_STACKS=false
# true si Node está detrás de un reverse proxy (nginx, Caddy, túnel): sin esto
# todas las peticiones llegan con la IP del proxy y los límites por IP son globales.
TRUST_PROXY=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medicai"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
RESEND_API_KEY="re_xxxxxxxxx"
GROQ_API_KEY="gsk_xxxxxxxxx"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
# Voz → texto del asistente (opcional).
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
MAIL_FROM="MedicAI <soporte@medicai.lat>"
# URL pública que aparece en los correos: botón y enlace alternativo.
# Debe apuntar al dominio público de MedicAI, no al servidor/funnel.
APP_BASE_URL="https://medicai.lat"
APP_DEEP_LINK_BASE_URL="medicai://auth"
ALLOWED_ORIGINS="https://medicai.lat,http://localhost:8081,http://localhost:19000,http://localhost:3000"

# Monitoreo de errores (Sentry). Opcional: vacío = desactivado.
# DSN del proyecto "Node.js" en sentry.io → Settings → Client Keys (DSN).
SENTRY_DSN=""
